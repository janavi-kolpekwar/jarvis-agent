# ── Required ────────────────────────────────────────────────
# Your Anthropic API key — https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Security (strongly recommended once deployed) ───────────
# Any secret string. The app locks until this is entered.
JARVIS_PASSCODE=

# ── Google (Gmail + Calendar) ───────────────────────────────
# 1. console.cloud.google.com → APIs & Services → enable "Gmail API"
#    and "Google Calendar API"
# 2. Credentials → Create OAuth client ID → Web application →
#    add redirect URI: http://localhost:53682/callback
# 3. Paste the client id/secret below, then run: npm run google:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN is appended automatically by google:auth

# ── Pocket AI notes (optional, via MCP) ─────────────────────
# If Pocket provides an MCP server URL + token (check Pocket's
# settings → integrations/API), paste them here.
POCKET_MCP_URL=
POCKET_MCP_TOKEN=
